{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/|@|src/|node_modules/|__vite|.*\\..*).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/delete-inactive",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/normalize-addresses",
      "schedule": "30 3 * * *"
    }
  ]
}
